{
  "version": "2.1.0",
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "Strix",
          "informationUri": "https://strix.ai",
          "rules": [
            {
              "id": "strix-coverage/routing-authentication-middleware",
              "name": "Routing & Authentication Middleware",
              "shortDescription": {
                "text": "Coverage: Routing & Authentication Middleware"
              },
              "fullDescription": {
                "text": "Coverage of Routing & Authentication Middleware across the assessed attack surface."
              },
              "defaultConfiguration": {
                "level": "none"
              },
              "help": {
                "text": "Coverage of Routing & Authentication Middleware across the assessed attack surface.",
                "markdown": "Coverage of Routing & Authentication Middleware across the assessed attack surface."
              },
              "properties": {
                "tags": [
                  "coverage"
                ]
              }
            },
            {
              "id": "strix-coverage/idor-object-level-authorization",
              "name": "IDOR & Object-Level Authorization",
              "shortDescription": {
                "text": "Coverage: IDOR & Object-Level Authorization"
              },
              "fullDescription": {
                "text": "Coverage of IDOR & Object-Level Authorization across the assessed attack surface."
              },
              "defaultConfiguration": {
                "level": "none"
              },
              "help": {
                "text": "Coverage of IDOR & Object-Level Authorization across the assessed attack surface.",
                "markdown": "Coverage of IDOR & Object-Level Authorization across the assessed attack surface."
              },
              "properties": {
                "tags": [
                  "coverage"
                ]
              }
            }
          ],
          "version": "1.7.0"
        }
      },
      "results": [
        {
          "ruleId": "strix-coverage/routing-authentication-middleware",
          "ruleIndex": 0,
          "kind": "pass",
          "level": "none",
          "message": {
            "text": "Routing & Authentication Middleware — No issue identified: routes/web.php & routes/api.php\n\nReviewed web.php and api.php routing files. Auth middleware and role checks are configured across application endpoints."
          },
          "locations": [
            {
              "logicalLocations": [
                {
                  "fullyQualifiedName": "routes/web.php & routes/api.php"
                }
              ]
            }
          ],
          "properties": {
            "strix": {
              "coverage_outcome": "no_issue_found",
              "risk_area": "Routing & Authentication Middleware",
              "surface": "routes/web.php & routes/api.php",
              "recorded_by": "Root Agent",
              "source": "agent_reported"
            }
          }
        },
        {
          "ruleId": "strix-coverage/idor-object-level-authorization",
          "ruleIndex": 1,
          "kind": "pass",
          "level": "none",
          "message": {
            "text": "IDOR & Object-Level Authorization — No issue identified: app/Http/Controllers\n\nReviewed Http Controllers for authorization gates, model policies, and object-level access controls on sensitive resources."
          },
          "locations": [
            {
              "logicalLocations": [
                {
                  "fullyQualifiedName": "app/Http/Controllers"
                }
              ]
            }
          ],
          "properties": {
            "strix": {
              "coverage_outcome": "no_issue_found",
              "risk_area": "IDOR & Object-Level Authorization",
              "surface": "app/Http/Controllers",
              "recorded_by": "Root Agent",
              "source": "agent_reported"
            }
          }
        }
      ],
      "invocations": [
        {
          "executionSuccessful": true
        }
      ]
    }
  ]
