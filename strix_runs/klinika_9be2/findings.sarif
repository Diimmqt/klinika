{
  "version": "2.1.0",
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "Strix",
          "informationUri": "https://strix.ai",
          "rules": [
            {
              "id": "strix-coverage/static-code-reconnaissance-mapping",
              "name": "Static Code Reconnaissance & Mapping",
              "shortDescription": {
                "text": "Coverage: Static Code Reconnaissance & Mapping"
              },
              "fullDescription": {
                "text": "Coverage of Static Code Reconnaissance & Mapping across the assessed attack surface."
              },
              "defaultConfiguration": {
                "level": "none"
              },
              "help": {
                "text": "Coverage of Static Code Reconnaissance & Mapping across the assessed attack surface.",
                "markdown": "Coverage of Static Code Reconnaissance & Mapping across the assessed attack surface."
              },
              "properties": {
                "tags": [
                  "coverage"
                ]
              }
            }
          ],
          "version": "1.7.0"
        }
      },
      "results": [
        {
          "ruleId": "strix-coverage/static-code-reconnaissance-mapping",
          "ruleIndex": 0,
          "kind": "open",
          "level": "none",
          "message": {
            "text": "Static Code Reconnaissance & Mapping — Requires further review: /workspace/klinika\n\nInspected /workspace/klinika via shell commands (ls, rg, find); the directory is completely empty, so static code analysis and mapping could not be performed."
          },
          "locations": [
            {
              "logicalLocations": [
                {
                  "fullyQualifiedName": "/workspace/klinika"
                }
              ]
            }
          ],
          "properties": {
            "strix": {
              "coverage_outcome": "needs_follow_up",
              "risk_area": "Static Code Reconnaissance & Mapping",
              "surface": "/workspace/klinika",
              "recorded_by": "Code Recon Specialist",
              "source": "agent_reported"
            }
          }
        }
      ],
      "invocations": [
        {
          "executionSuccessful": false,
          "toolExecutionNotifications": [
            {
              "level": "warning",
              "message": {
                "text": "The scan ended with status 'stopped' rather than completing, so coverage reflects only the work finished before it stopped."
              }
            },
            {
              "level": "warning",
              "message": {
                "text": "1 agent(s) did not finish cleanly (Root Agent); any surface they held is under-covered."
              }
            }
          ]
        }
      ]
    }
  ]
}
