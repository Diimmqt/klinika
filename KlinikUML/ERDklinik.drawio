  <diagram name="Halaman-1" id="Kw-rF4PacP3ZFzHHORU9">
    <mxGraphModel dx="1433" dy="775" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;erDiagram\n    USERS ||--o{ USER_ROLES : \&quot;punya\&quot;\n    ROLES ||--o{ USER_ROLES : \&quot;dimiliki\&quot;\n    ROLES ||--o{ ROLE_PERMISSIONS : \&quot;punya\&quot;\n    PERMISSIONS ||--o{ ROLE_PERMISSIONS : \&quot;dimiliki\&quot;\n    USERS |o--o| PRACTITIONERS : \&quot;akun login\&quot;\n    PRACTITIONERS ||--o{ SCHEDULES : \&quot;punya jadwal\&quot;\n    POLIS ||--o{ SCHEDULES : \&quot;dijadwalkan di\&quot;\n    PATIENTS ||--o{ VISITS : \&quot;melakukan\&quot;\n    POLIS ||--o{ VISITS : \&quot;tujuan\&quot;\n    PRACTITIONERS |o--o{ VISITS : \&quot;dokter tujuan\&quot;\n    USERS ||--o{ VISITS : \&quot;dibuat oleh\&quot;\n    USERS ||--o{ PATIENTS : \&quot;dibuat oleh\&quot;\n    VISITS ||--o| QUEUES : \&quot;memiliki\&quot;\n    POLIS ||--o{ QUEUES : \&quot;antrean poli\&quot;\n    POLIS ||--o{ QUEUE_COUNTERS : \&quot;counter\&quot;\n    QUEUES ||--o{ QUEUE_STATUS_LOGS : \&quot;riwayat status\&quot;\n    USERS |o--o{ QUEUE_STATUS_LOGS : \&quot;diubah oleh\&quot;\n\n    USERS {\n        bigint id PK\n        string name\n        string email UK\n        string password \&quot;hash\&quot;\n        boolean is_active\n        datetime last_login_at\n        datetime created_at\n        datetime updated_at\n    }\n\n    ROLES {\n        bigint id PK\n        string name UK \&quot;contoh: dokter\&quot;\n        string display_name\n        string description\n        datetime created_at\n        datetime updated_at\n    }\n\n    PERMISSIONS {\n        bigint id PK\n        string name UK \&quot;contoh: patient.view\&quot;\n        string description\n        datetime created_at\n        datetime updated_at\n    }\n\n    USER_ROLES {\n        bigint user_id PK, FK\n        bigint role_id PK, FK\n    }\n\n    ROLE_PERMISSIONS {\n        bigint role_id PK, FK\n        bigint permission_id PK, FK\n    }\n\n    POLIS {\n        bigint id PK\n        string code UK\n        string name\n        string queue_prefix UK \&quot;contoh: A, B, U\&quot;\n        boolean is_active\n        datetime created_at\n        datetime updated_at\n    }\n\n    PRACTITIONERS {\n        bigint id PK\n        bigint user_id FK \&quot;nullable, UK\&quot;\n        string name\n        string practitioner_type \&quot;dokter, perawat, apoteker\&quot;\n        string str_number\n        string sip_number\n        string satusehat_practitioner_id \&quot;nullable\&quot;\n        boolean is_active\n        datetime created_at\n        datetime updated_at\n    }\n\n    SCHEDULES {\n        bigint id PK\n        bigint practitioner_id FK\n        bigint poli_id FK\n        tinyint day_of_week \&quot;1-7\&quot;\n        time start_time\n        time end_time\n        int quota \&quot;nullable\&quot;\n        boolean is_active\n        datetime created_at\n        datetime updated_at\n    }\n\n    NUMBER_SEQUENCES {\n        bigint id PK\n        string sequence_name \&quot;medical_record, visit\&quot;\n        string period_key \&quot;contoh: 2026 atau 20261006\&quot;\n        int last_number\n        datetime updated_at\n    }\n\n    PATIENTS {\n        bigint id PK\n        string medical_record_number UK \&quot;dari number_sequences\&quot;\n        string nik UK \&quot;nullable\&quot;\n        string name\n        string gender\n        string birth_place\n        date birth_date\n        string phone\n        text address\n        string blood_type \&quot;nullable\&quot;\n        string satusehat_ihs_number \&quot;nullable\&quot;\n        bigint created_by FK\n        datetime created_at\n        datetime updated_at\n        datetime deleted_at \&quot;soft delete\&quot;\n    }\n\n    VISITS {\n        bigint id PK\n        string visit_number UK \&quot;dari number_sequences\&quot;\n        bigint patient_id FK\n        bigint poli_id FK\n        bigint practitioner_id FK \&quot;nullable\&quot;\n        date visit_date\n        string status \&quot;registered, in_progress, completed, cancelled\&quot;\n        text complaint \&quot;nullable\&quot;\n        bigint created_by FK\n        datetime created_at\n        datetime updated_at\n    }\n\n    QUEUE_COUNTERS {\n        bigint id PK\n        bigint poli_id FK \&quot;UK gabungan dengan queue_date\&quot;\n        date queue_date\n        int last_number\n        datetime updated_at\n    }\n\n    QUEUES {\n        bigint id PK\n        bigint visit_id FK \&quot;UK\&quot;\n        bigint poli_id FK \&quot;harus sama dengan visits.poli_id\&quot;\n        date queue_date\n        int queue_number \&quot;UK gabungan poli_id, queue_date, queue_number\&quot;\n        string queue_code \&quot;queue_prefix + nomor, contoh A-001\&quot;\n        string status \&quot;menunggu, dipanggil, sedang_dilayani, selesai\&quot;\n        datetime called_at \&quot;nullable\&quot;\n        datetime started_at \&quot;nullable\&quot;\n        datetime finished_at \&quot;nullable\&quot;\n        datetime created_at\n        datetime updated_at\n    }\n\n    QUEUE_STATUS_LOGS {\n        bigint id PK\n        bigint queue_id FK\n        string from_status \&quot;nullable\&quot;\n        string to_status\n        bigint changed_by FK \&quot;nullable\&quot;\n        datetime changed_at\n    }&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="MfglC7HB3QZz5YTWKfw3-1">
